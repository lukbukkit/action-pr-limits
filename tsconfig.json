{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./lib",
    "noEmit": true,
    "strict": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "isolatedModules": true,
  },
  "exclude": ["node_modules", "**/*.test.ts"]
}